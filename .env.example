# Server-only. Never prefix with NEXT_PUBLIC_.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3.1-flash-lite
GEMINI_MODEL=

# Correo del formulario de agendar (Gmail gratis).
# Activá la verificación en 2 pasos y creá una contraseña de aplicación: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcional: a dónde llegan los pedidos (por defecto, GMAIL_USER).
BOOKING_TO=

# Opcional: respaldo del chat en Groq (gratis, sin tarjeta): https://console.groq.com/keys
# Si está, el chat lo usa cuando Gemini tarda o falla.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Respaldo del chat con otro proveedor (cualquiera con API compatible con OpenAI). Si no usás Groq:
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Calendar + Meet (docs/PLAN_CONEXIONES.md, paso 1). Sin esto el formulario funciona solo por correo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene una vez con: node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=
# Opcional: otro calendario distinto del principal de la cuenta.
# GOOGLE_CALENDAR_ID=

# Límite de uso compartido (Upstash Redis). Vercel carga estas dos al conectar la integración.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcional: planilla de contactos (webhook de Apps Script).
# LEADS_WEBHOOK_URL=

# Opcional: número de WhatsApp (por defecto 5493794530578) y dirección pública del sitio.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_SITE_URL=

